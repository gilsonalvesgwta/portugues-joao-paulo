# Copie para .env.local e preencha. Nunca envie o arquivo preenchido ao repositório.

# Endereço do aplicativo (usado nos links enviados por e-mail)
SITE_URL=http://127.0.0.1:3000

# Login e dados. Há dois jeitos de instalar (veja src/lib/supabase/config.ts):
#
# 1. Banco próprio (produção na VPS, deploy/portainer-stack.yml): em vez das três variáveis
#    abaixo, use os endereços internos dos serviços e o segredo; o aplicativo assina as chaves.
#      SUPABASE_AUTH_URL=http://portuguesjp_auth:9999
#      SUPABASE_REST_URL=http://portuguesjp_rest:3000
#      SUPABASE_JWT_SECRET=
#
# 2. Supabase completo (desenvolvimento e testes): endereço, chave pública (anon) e chave de serviço.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Supabase: chave de serviço. Só no servidor. Dá acesso total ao banco.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails.
# "arquivo" grava cada e-mail em EMAIL_PASTA em vez de enviar (desenvolvimento e testes).
# "smtp" envia pela caixa de e-mail da hospedagem (produção).
EMAIL_DRIVER=arquivo
EMAIL_PASTA=./caixa-de-saida

# Só para EMAIL_DRIVER=smtp. Na Hostinger: smtp.hostinger.com, porta 465.
# SMTP_USER é o endereço completo da caixa; SMTP_PASS é a senha dela (nunca no repositório).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remetente que aparece para o aluno. Em geral, o mesmo endereço de SMTP_USER.
EMAIL_REMETENTE=
EMAIL_NOME_REMETENTE=Português com João Paulo

# Primeiro administrador. Se não existir nenhum administrador, o aplicativo cria este ao subir.
# Depois que existe um, estas variáveis não fazem mais nada.
ADMIN_EMAIL=
ADMIN_SENHA_INICIAL=
